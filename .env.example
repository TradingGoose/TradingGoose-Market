# Database
DATABASE_URL=postgres://postgres:password@localhost:5432/tradinggoose_market

# Canonical application and Better Auth origins
NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
# Production requires exactly 64 lowercase hexadecimal characters. Generate it
# with `openssl rand -hex 32`; this checked-in sentinel is intentionally invalid.
BETTER_AUTH_SECRET=replace-with-64-lowercase-hex-characters
REGISTRATION_MODE=open

# Server-only direct Resend authentication email. RESEND_FROM_EMAIL must be a
# complete sender on an operator-verified Resend domain.
RESEND_API_KEY=re_replace_me
RESEND_FROM_EMAIL=TradingGoose Market <market@example.com>
# Optional audience used only for best-effort verified-user contact projection.
# RESEND_AUDIENCE_ID=aud_replace_me

# One Market PAYG rate (required in both billing modes)
BILLING_ENABLED=false
PAYG_USD_PER_1000_READS=1.00

# Stripe is required when billing is enabled. While disabled, omit all Stripe
# values, set STRIPE_SECRET_KEY alone for best-effort Customer provisioning, or
# set the complete secret/webhook/Price triple for webhook synchronization.
# STRIPE_SECRET_KEY=sk_test_replace_me
# STRIPE_WEBHOOK_SECRET=whsec_replace_me
# PAYG_STRIPE_PRICE_ID=price_replace_me
# PAYG_INVOICE_THRESHOLD_USD=50

# Copy the API ID (api_...) from Keyspace Settings, not the Keyspace ID (ks_...).
# The API ID identifies the target keyspace; it is not a credential.
UNKEY_API_ID=api_replace_me
# One server-only root key for key management, verification, and optional
# anonymous limiting. See README.md for the required permissions.
UNKEY_ROOT_KEY=unkey_replace_me

# Anonymous public reads are unlimited when both policy values are absent.
# Configure the complete pair and its Unkey namespace to limit one service-wide
# anonymous bucket; UNKEY_ROOT_KEY also needs limit permission on this namespace.
# ANONYMOUS_RATE_LIMIT=100
# ANONYMOUS_RATE_LIMIT_DURATION_SECONDS=60
# UNKEY_ANONYMOUS_NAMESPACE_ID=namespace_replace_me

# Redis remains optional and is used only by the existing response cache.
# REDIS_URL=redis://default:password@localhost:6379

# Optional file-storage override: LOCAL, VERCEL, or AZURE. When unset, the
# original auto-detection selects VERCEL for only complete Vercel credentials,
# AZURE for only complete Azure credentials, and LOCAL when neither or both
# credential sets are complete. Detecting both selects LOCAL and emits a
# warning. An explicit value overrides auto-detection.
# STORAGE_SERVICE=LOCAL

# Azure requires the container plus either a connection string or the complete
# account-name/account-key pair.
# AZURE_STORAGE_CONTAINER_NAME=market-files
# AZURE_CONNECTION_STRING=replace_me
# AZURE_ACCOUNT_NAME=replace_me
# AZURE_ACCOUNT_KEY=replace_me

# Vercel Blob requires its server-only read/write token.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_replace_me
