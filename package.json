{
  "name": "tradinggoose-market",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "uploads"
  ],
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "bun run db:build && next build",
    "start": "bun --env-file=.env node_modules/next/dist/bin/next start",
    "lint": "eslint .",
    "type-check": "bun run db:build && tsc --noEmit",
    "test": "bun run db:build && vitest run",
    "test:release": "bun run tests/release/production-server-smoke.ts",
    "test:watch": "bun run db:build && vitest",
    "db:build": "bun run --cwd ./packages/db build",
    "db:generate": "bun run --cwd ./packages/db db:generate",
    "db:migrate": "bun run --cwd ./packages/db db:migrate",
    "admin:manage": "bun run scripts/manage-market-admin.ts"
  },
  "dependencies": {
    "@azure/storage-blob": "^12.27.0",
    "@hookform/resolvers": "^4.1.1",
    "@radix-ui/react-avatar": "^1.0.4",
    "@radix-ui/react-checkbox": "^1.0.5",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.3",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@react-email/components": "1.0.12",
    "@react-email/render": "2.0.4",
    "@tanstack/react-table": "^8.20.5",
    "@unkey/api": "2.4.0",
    "@unkey/ratelimit": "2.1.4",
    "@vercel/blob": "^2.0.0",
    "better-auth": "1.4.18",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "csv-parse": "^5.5.6",
    "csv-stringify": "^6.5.0",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.44.5",
    "geist": "^1.5.1",
    "input-otp": "1.4.2",
    "ioredis": "^5.10.1",
    "lucide-react": "^0.562.0",
    "mime": "^4.0.4",
    "motion": "12.23.25",
    "next": "^16.1.0",
    "next-themes": "^0.4.6",
    "papaparse": "^5.4.1",
    "postgres": "^3.4.5",
    "radix-ui": "^1.4.3",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-hook-form": "^7.54.2",
    "recharts": "3.9.2",
    "resend": "6.10.0",
    "stripe": "19.1.0",
    "tailwind-merge": "^3.4.0",
    "three": "0.181.2",
    "three-globe": "2.45.2",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "25.2.1",
    "@types/three": "0.181.0",
    "autoprefixer": "^10.4.23",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.13.0",
    "eslint-config-next": "16.1.0",
    "jsdom": "29.1.1",
    "postcss": "^8.5.6",
    "tailwindcss": "3.4.15",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.6.3",
    "vitest": "4.1.10"
  }
}
